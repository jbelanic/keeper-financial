          {
            "name": "agent",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z0-9-]{1,100}$"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Agent"
            }
          }
        ],
        "responses": {
          "307": {
            "description": "Successful Response"
          },
          "503": {
            "description": "Configured application destination unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
