  "components": {
    "schemas": {
      "AccessResponse": {
        "properties": {
          "allowed": {
            "type": "boolean",
            "title": "Allowed"
          },
          "area": {
            "type": "string",
            "title": "Area"
          },
          "user_id": {
            "type": "string",
            "format": "uuid",
            "title": "User Id"
          },
          "roles": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Roles"
          }
        },
        "type": "object",
        "required": [
          "allowed",
          "area",
          "user_id",
          "roles"
        ],
        "title": "AccessResponse"
      },
      "AgentProfileStatus": {
        "type": "string",
        "enum": [
          "draft",
          "pending_approval",
          "published",
          "suspended",
          "archived"
        ],
        "title": "AgentProfileStatus"
      },
      "AgentStatusResponse": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/AgentProfileStatus"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "AgentStatusResponse"
      },
      "AgentTransitionRequest": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/AgentProfileStatus"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "AgentTransitionRequest"
      },
      "CandidateStatus": {
        "type": "string",
        "enum": [
          "prospect",
          "application_started",
          "application_submitted",
          "under_review",
          "more_information_required",
          "interview",
          "conditionally_selected",
          "declined",
          "withdrawn",
          "onboarding_in_progress",
          "pending_fsra_authorization",
          "pending_system_provisioning",
          "active",
          "suspended",
          "offboarding",
          "offboarded"
        ],
        "title": "CandidateStatus"
      },
      "CandidateStatusResponse": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/CandidateStatus"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "CandidateStatusResponse"
      },
      "CandidateTransitionRequest": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/CandidateStatus"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "CandidateTransitionRequest"
      },
      "ConsentState": {
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "granted",
              "withdrawn"
            ],
            "title": "State"
          },
          "granted_at": {
            "type": "string",
            "format": "date-time",
            "title": "Granted At"
          },
          "withdrawn_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Withdrawn At"
          }
        },
        "type": "object",
        "required": [
          "state",
          "granted_at",
          "withdrawn_at"
        ],
        "title": "ConsentState"
      },
      "DatabaseHealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status"
          },
          "database": {
            "type": "string",
            "enum": [
              "reachable",
              "unreachable"
            ],
            "title": "Database"
          }
        },
        "type": "object",
        "required": [
          "status",
          "database"
        ],
        "title": "DatabaseHealthResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "service": {
            "type": "string",
            "title": "Service"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service"
        ],
        "title": "HealthResponse"
      },
      "LeadInquiryCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 2,
            "title": "Name"
          },
          "email": {
            "type": "string",
            "maxLength": 320,
            "format": "email",
            "title": "Email"
          },
          "telephone": {
            "type": "string",
            "maxLength": 32,
            "minLength": 7,
            "pattern": "^[0-9+().\\- x]+$",
            "title": "Telephone"
          },
          "mortgage_objective": {
            "type": "string",
            "enum": [
              "purchase",
              "refinance",
              "renewal",
              "investment",
              "other"
            ],
            "title": "Mortgage Objective"
          },
          "preferred_contact_method": {
            "type": "string",
            "enum": [
              "email",
              "telephone"
            ],
            "title": "Preferred Contact Method"
          },
          "preferred_agent_slug": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100,
                "pattern": "^[a-z0-9-]+$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Preferred Agent Slug"
          },
          "message": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "service_contact_acknowledged": {
            "type": "boolean",
            "title": "Service Contact Acknowledged"
          },
          "marketing_consent": {
            "type": "boolean",
            "title": "Marketing Consent",
            "default": false
          },
          "website": {
            "type": "string",
            "maxLength": 0,
            "title": "Website",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "email",
          "telephone",
          "mortgage_objective",
          "preferred_contact_method",
          "service_contact_acknowledged"
        ],
        "title": "LeadInquiryCreate"
      },
      "LeadInquiryCreated": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "marketing_consent_recorded": {
            "type": "boolean",
            "title": "Marketing Consent Recorded"
          }
        },
        "type": "object",
        "required": [
          "id",
          "status",
          "marketing_consent_recorded"
        ],
        "title": "LeadInquiryCreated"
      },
      "LeadListItem": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "email": {
            "type": "string",
            "maxLength": 320,
            "format": "email",
            "title": "Email"
          },
          "telephone": {
            "type": "string",
            "title": "Telephone"
          },
          "mortgage_objective": {
            "type": "string",
            "enum": [
              "purchase",
              "refinance",
              "renewal",
              "investment",
              "other"
            ],
            "title": "Mortgage Objective"
          },
          "preferred_contact_method": {
            "type": "string",
            "enum": [
              "email",
              "telephone"
            ],
            "title": "Preferred Contact Method"
          },
          "preferred_agent_slug": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Preferred Agent Slug"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "status": {
            "type": "string",
            "enum": [
              "new",
              "assigned",
              "contacted",
              "closed"
            ],
            "title": "Status"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
