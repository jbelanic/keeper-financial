                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Dev-Auth-Sub"
            }
          },
          {
            "name": "x-dev-auth-aal",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "aal1",
              "title": "X-Dev-Auth-Aal"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
