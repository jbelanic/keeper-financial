# Keeper Financial — Documenso production secret keys.
#
# Install as /home/inspiron/documenso/.secrets.env (mode 600, never committed).
# Do not paste real values into this file, a ticket, a chat, or a shell that logs.
#
# Generate on the host, then append to .secrets.env:
#
#   umask 077
#   {
#     echo "POSTGRES_PASSWORD=$(openssl rand -hex 24)"
#     echo "NEXTAUTH_SECRET=$(openssl rand -hex 32)"
#     echo "NEXT_PRIVATE_ENCRYPTION_KEY=$(openssl rand -hex 32)"
#     echo "NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY=$(openssl rand -hex 32)"
#   } > /home/inspiron/documenso/.secrets.env
#
#   PW="$(grep '^POSTGRES_PASSWORD=' /home/inspiron/documenso/.secrets.env | cut -d= -f2)"
#   {
#     echo "DATABASE_URL=postgresql://documenso:${PW}@db:5432/documenso"
#     echo "NEXT_PRIVATE_DATABASE_URL=postgres://documenso:${PW}@db:5432/documenso"
#     echo "NEXT_PRIVATE_DIRECT_DATABASE_URL=postgres://documenso:${PW}@db:5432/documenso"
#   } >> /home/inspiron/documenso/.secrets.env
#   unset PW
#
#   # passphrase: the value written to certificates/.signing.passphrase
#   printf 'NEXT_PRIVATE_SIGNING_PASSPHRASE=%s\n' \
#     "$(cat /home/inspiron/documenso/certificates/.signing.passphrase)" \
#     >> /home/inspiron/documenso/.secrets.env
#
#   # SMTP2GO: read interactively so values never reach shell history
#   read -rsp 'SMTP2GO username: ' SMTPU; echo
#   read -rsp 'SMTP2GO SMTP password: ' SMTPP; echo
#   printf 'NEXT_PRIVATE_SMTP_USER=%s\nNEXT_PRIVATE_SMTP_PASSWORD=%s\n' "$SMTPU" "$SMTPP" \
#     >> /home/inspiron/documenso/.secrets.env
#   unset SMTPU SMTPP
#
# Key contract required by the stack:

POSTGRES_PASSWORD=
DATABASE_URL=
NEXT_PRIVATE_DATABASE_URL=
NEXT_PRIVATE_DIRECT_DATABASE_URL=
NEXTAUTH_SECRET=
NEXT_PRIVATE_ENCRYPTION_KEY=
NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY=
NEXT_PRIVATE_SIGNING_PASSPHRASE=
NEXT_PRIVATE_SMTP_USER=
NEXT_PRIVATE_SMTP_PASSWORD=
