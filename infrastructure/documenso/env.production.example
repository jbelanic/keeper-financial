# Keeper Financial — Documenso production, NON-SECRET configuration.
#
# Install as /home/inspiron/documenso/.env (mode 600) next to .secrets.env, then
# follow docs/operations/documenso-deployment.md.
#
# Secret values are NOT set here. See secrets.production.example for the keys that
# belong in .secrets.env.

POSTGRES_USER=documenso
POSTGRES_DB=documenso

# Exact production origin. The Keeper API validator rejects any other shape
# (apps/api/src/keeper_api/core/config.py:296-329).
NEXTAUTH_URL=https://sign.keeperfinancial.ca
NEXT_PUBLIC_URL=https://sign.keeperfinancial.ca
NEXT_PUBLIC_API_URL=https://sign.keeperfinancial.ca
NEXT_PUBLIC_WEBAPP_URL=https://sign.keeperfinancial.ca
# URL the app uses to call itself (background job dispatch via /api/jobs).
# Must be reachable from inside the container: the loopback port, not the public
# origin. The public origin needs DNS hairpin + a live certificate, and a failed
# self-call crashes the job scheduler at boot.
NEXT_PRIVATE_INTERNAL_WEBAPP_URL=http://127.0.0.1:3001

PORT=3001
DOCUMENSO_DISABLE_TELEMETRY=true
DOCUMENSO_DISABLE_EMAIL=0

REDIS_URL=redis://redis:6379
NEXT_PRIVATE_REDIS_URL=redis://redis:6379

# Local PKCS#12 signing transport, mounted read-only from ./certificates/cert.p12.
NEXT_PRIVATE_SIGNING_TRANSPORT=local
NEXT_PRIVATE_SIGNING_LOCAL_FILE_PATH=/opt/documenso/cert.p12

# Transactional email — SMTP2GO. Credentials live in .secrets.env.
NEXT_PRIVATE_SMTP_TRANSPORT=smtp-auth
NEXT_PRIVATE_SMTP_HOST=mail.smtp2go.com
NEXT_PRIVATE_SMTP_PORT=2525
NEXT_PRIVATE_SMTP_SECURE=false
NEXT_PRIVATE_SMTP_FROM_NAME=Keeper Financial
NEXT_PRIVATE_SMTP_FROM_ADDRESS=no-reply@keeperfinancial.ca

NEXT_PRIVATE_OIDC_PROMPT=login
