# Local Linux Docker is the live/production deployment. Copy this file to .env,
# replace every change-me value, and keep .env untracked.
APP_ENV=production
APP_NAME=Keeper Financial API
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000
WEB_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Compose constructs the API DATABASE_URL from these URL-safe values and the db
# service name. Keep POSTGRES_PASSWORD URL-safe unless it is percent-encoded.
POSTGRES_DB=keeper
POSTGRES_USER=keeper
POSTGRES_PASSWORD=change-me-database-password
DATABASE_URL=postgresql+psycopg://keeper:change-me-database-password@db:5432/keeper

# The tracked Supabase CLI config supplies local Auth. Generate its ignored ES256
# signing key with `npx supabase gen signing-key --algorithm ES256` before startup.
# The issuer is embedded in tokens; Compose routes JWKS through the host gateway.
SUPABASE_ISSUER=http://127.0.0.1:54321/auth/v1
SUPABASE_AUDIENCE=authenticated
SUPABASE_JWKS_URL=http://host.docker.internal:54321/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ALGORITHMS=ES256
DEV_AUTH_ENABLED=false
REQUIRE_ADMIN_MFA=true

# Public lead abuse controls are always enabled. Forwarded client-IP headers are not trusted.
LEAD_RATE_LIMIT_REQUESTS=5
LEAD_RATE_LIMIT_WINDOW_SECONDS=60
LEAD_RATE_LIMIT_TRACKED_CLIENTS=10000

# MinIO is the only live object store. Compose injects its internal/public S3
# endpoints and credentials into the API and creates this private bucket once.
MINIO_ROOT_USER=change-me-minio-user
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_BUCKET=keeper-private
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=change-me-minio-user
S3_SECRET_ACCESS_KEY=change-me-minio-password
S3_BUCKET=keeper-private
S3_REGION=us-east-1
PUBLIC_OBJECT_URLS_ENABLED=false
MAX_DOCUMENT_BYTES=10485760
ALLOWED_DOCUMENT_MIME_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document
# ClamAV is the live local scanner. The API always fails closed when clamd cannot
# return a bounded, well-formed decision; Compose overrides the host to `clamav`.
MALWARE_SCANNER_BACKEND=clamav
MALWARE_SCANNER_FAIL_CLOSED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_CONNECT_TIMEOUT_SECONDS=2
CLAMAV_READ_TIMEOUT_SECONDS=15
CLAMAV_MAX_CHUNKS=256
CLAMAV_MAX_RESPONSE_BYTES=4096
SIGNED_URL_TTL_SECONDS=60

# The owner-approved secure application uses the existing configuration-only redirect boundary.
MORTGAGE_APPLICATION_PROVIDER=keeper_secure_application
MORTGAGE_APPLICATION_URL=https://apply.keeperfinancial.ca/
MORTGAGE_APPLICATION_ALLOWED_HOSTS=apply.keeperfinancial.ca
# JSON object keyed only by approved agent slugs, e.g. {"sample-agent":"https://apply.example.test/sample-agent"}
MORTGAGE_APPLICATION_AGENT_LINKS={}
ESIGN_PROVIDER=disabled
CRM_PROVIDER=disabled

# Server-side traffic uses Compose DNS; browser-visible traffic uses host ports.
API_INTERNAL_URL=http://api:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Obtain only the local anon key from `npx supabase status`; it is browser-visible, not authorization.
NEXT_PUBLIC_SUPABASE_ANON_KEY=change-me-local-supabase-anon-key

# Owner-approved public identity and contact values. NEXT_PUBLIC_* values are never secrets.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BROKERAGE_DISPLAY_NAME=Keeper Financial
NEXT_PUBLIC_BROKERAGE_LEGAL_NAME=Keeper Financial Inc.
NEXT_PUBLIC_BROKERAGE_REGULATORY_TEXT="FSCO # 13696"
NEXT_PUBLIC_PUBLIC_ADDRESS="380 Wellington Street, Tower B, 6th Floor, London ON, N6A 5B5"
NEXT_PUBLIC_PUBLIC_EMAIL=support@keeperfinancial.ca
NEXT_PUBLIC_PUBLIC_PHONE="+1 (709) 700-7339"
NEXT_PUBLIC_PUBLIC_PHONE_E164=+17097007339
NEXT_PUBLIC_MORTGAGE_APPLICATION_URL=https://apply.keeperfinancial.ca/
NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_PRINCIPAL_BROKER=
