# Runtime tier: local | staging_non_sensitive | production
APP_ENV=local
APP_NAME=Keeper Financial API
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000
WEB_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql+psycopg://keeper:keeper_local_only@localhost:5432/keeper

# Supabase Auth proves identity only. The application database grants access.
# Run `supabase start` for local Auth, then use values printed by `supabase status`.
SUPABASE_ISSUER=http://127.0.0.1:54321/auth/v1
SUPABASE_AUDIENCE=authenticated
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ALGORITHMS=ES256
DEV_AUTH_ENABLED=true
REQUIRE_ADMIN_MFA=false

# Public lead abuse controls are always enabled. Forwarded client-IP headers are not trusted.
LEAD_RATE_LIMIT_REQUESTS=5
LEAD_RATE_LIMIT_WINDOW_SECONDS=60
LEAD_RATE_LIMIT_TRACKED_CLIENTS=10000

# Local filesystem is valid only when APP_ENV=local.
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage/dev_uploads
PUBLIC_OBJECT_URLS_ENABLED=false
MAX_DOCUMENT_BYTES=10485760
ALLOWED_DOCUMENT_MIME_TYPES=application/pdf,image/jpeg,image/png

# R2 is mandatory when STORAGE_BACKEND=r2. The bucket must remain private.
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_REGION=auto
SIGNED_URL_TTL_SECONDS=60

# External providers are configuration/adapter boundaries only in Phase 0.
MORTGAGE_APPLICATION_PROVIDER=disabled
MORTGAGE_APPLICATION_URL=
MORTGAGE_APPLICATION_ALLOWED_HOSTS=
# JSON object keyed only by approved agent slugs, e.g. {"sample-agent":"https://apply.example.test/sample-agent"}
MORTGAGE_APPLICATION_AGENT_LINKS={}
ESIGN_PROVIDER=disabled
CRM_PROVIDER=disabled

# Server-side web configuration. Never expose provider secrets with NEXT_PUBLIC_*.
API_INTERNAL_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Regulatory values are deliberately unclaimed until the owner approves them.
NEXT_PUBLIC_BROKERAGE_LEGAL_NAME=Keeper Financial
NEXT_PUBLIC_BROKERAGE_LICENCE_NUMBER=Pending owner confirmation
